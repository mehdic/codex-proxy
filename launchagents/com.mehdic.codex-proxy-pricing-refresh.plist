<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mehdic.codex-proxy-pricing-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.openclaw/projects/codex-proxy/scripts/refresh-pricing-and-restart.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/.openclaw/projects/codex-proxy</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/.openclaw/logs/codex-proxy-pricing-refresh-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.openclaw/logs/codex-proxy-pricing-refresh-stderr.log</string>
</dict>
</plist>
